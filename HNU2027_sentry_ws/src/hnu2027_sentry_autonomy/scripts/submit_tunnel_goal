#!/usr/bin/env python3
"""Submit only a final goal. HNU determines all phases from measured feedback."""
import argparse,json,os,time
from pathlib import Path
import rclpy
from rclpy.node import Node
from geometry_msgs.msg import PoseStamped
from std_msgs.msg import String
from hnu_sentry_interfaces.msg import LowerControllerState

def main():
    parser=argparse.ArgumentParser()
    parser.add_argument("--x",type=float,default=-1.2)
    parser.add_argument("--y",type=float,default=3.5)
    parser.add_argument("--domain-id",type=int,default=182)
    parser.add_argument("--report",default="/tmp/hnu_autonomy_goal_report.json")
    args,rosargs=parser.parse_known_args()
    os.environ["ROS_DOMAIN_ID"]=str(args.domain_id)
    rclpy.init(args=rosargs)
    n=Node("submit_tunnel_goal",parameter_overrides=[
        rclpy.parameter.Parameter("use_sim_time",value=True)])
    latest={};feedback={};history=[]
    def status(m):
        try:
            value=json.loads(m.data)
            if not history or (value["phase"],value["reason"])!=(history[-1]["phase"],history[-1]["reason"]):
                history.append(value);print(m.data,flush=True)
            latest.update(value)
        except (ValueError,KeyError):pass
    n.create_subscription(String,"/mission/status",status,10)
    n.create_subscription(LowerControllerState,"/robot/controller_state",
                          lambda m:feedback.update(valid=m.valid,stopped=m.stopped,unfolded=m.unfolded),1)
    pub=n.create_publisher(PoseStamped,"/mission/goal",1)
    deadline=time.monotonic()+40
    sent=False;success=False;error=None
    try:
        while time.monotonic()<deadline:
            rclpy.spin_once(n,timeout_sec=.05)
            if (latest.get("localized") and feedback.get("valid") and feedback.get("stopped")
                    and feedback.get("unfolded") and pub.get_subscription_count()):
                goal=PoseStamped();goal.header.frame_id="map";goal.header.stamp=n.get_clock().now().to_msg()
                goal.pose.position.x=args.x;goal.pose.position.y=args.y;goal.pose.orientation.w=1.0
                pub.publish(goal);sent=True;break
        if not sent:raise RuntimeError("AMCL/feedback/mission interface not ready")
        deadline=time.monotonic()+160
        while time.monotonic()<deadline:
            rclpy.spin_once(n,timeout_sec=.05)
            if latest.get("reason") in ("robot_not_on_configured_entry_side","start_requires_measured_unfolded_stopped_robot"):
                raise RuntimeError(latest["reason"])
            if latest.get("phase") in ("abort","fallback"):
                raise RuntimeError(latest.get("reason"))
            if latest.get("reason")=="succeeded":
                if ((latest["x"]-args.x)**2+(latest["y"]-args.y)**2)**.5>.15:
                    raise RuntimeError("Goal reported success outside positional tolerance")
                success=True;break
        if not success:raise TimeoutError("mission did not complete")
    except Exception as exc:
        error=str(exc);print("FAIL: "+error,flush=True)
    finally:
        Path(args.report).write_text(json.dumps(dict(success=success,error=error,history=history),indent=2))
        n.destroy_node();rclpy.shutdown()
    if not success:raise SystemExit(1)
if __name__=="__main__":main()
