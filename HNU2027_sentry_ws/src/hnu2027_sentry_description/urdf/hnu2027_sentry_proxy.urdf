<?xml version="1.0"?>
<!--
  Stable integration contract for a future SolidWorks import:
  base_link, lidar_link, imu_link, upper_link, and fold_joint must be retained.
  Replace only visual/collision geometry and inertial values after measured data exist.
-->
<robot name="hnu2027_sentry_proxy">
  <link name="base_link">
    <visual><origin xyz="0 0 0.10"/><geometry><box size="0.32 0.32 0.20"/></geometry></visual>
    <collision><origin xyz="0 0 0.10"/><geometry><box size="0.32 0.32 0.20"/></geometry></collision>
  </link>
  <link name="upper_link">
    <visual><origin xyz="0 0 0.10"/><geometry><box size="0.26 0.24 0.20"/></geometry></visual>
    <collision><origin xyz="0 0 0.10"/><geometry><box size="0.26 0.24 0.20"/></geometry></collision>
  </link>
  <joint name="fold_joint" type="prismatic">
    <parent link="base_link"/><child link="upper_link"/>
    <origin xyz="0 0 0.20" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.16" upper="0.0" effort="200" velocity="0.10"/>
  </joint>
  <link name="lidar_link"/>
  <joint name="lidar_joint" type="fixed"><parent link="upper_link"/><child link="lidar_link"/><origin xyz="0 0 0.20" rpy="0 0 0"/></joint>
  <link name="imu_link"/>
  <joint name="imu_joint" type="fixed"><parent link="base_link"/><child link="imu_link"/><origin xyz="0 0 0.12" rpy="0 0 0"/></joint>
</robot>
