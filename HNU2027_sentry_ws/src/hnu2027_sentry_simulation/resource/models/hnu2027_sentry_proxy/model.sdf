<?xml version="1.0"?>
<sdf version="1.9">
  <model name="hnu2027_sentry_proxy">
    <static>false</static>
    <pose>0 0 0 0 0 0</pose>
    <link name="base_link">
      <inertial><mass>18.0</mass><inertia><ixx>0.25</ixx><iyy>0.25</iyy><izz>0.35</izz></inertia></inertial>
      <collision name="base_collision"><pose>0 0 0.10 0 0 0</pose><geometry><box><size>0.32 0.32 0.20</size></box></geometry></collision>
      <visual name="base_visual"><pose>0 0 0.10 0 0 0</pose><geometry><box><size>0.32 0.32 0.20</size></box></geometry><material><diffuse>0.20 0.20 0.24 1</diffuse></material></visual>
    </link>
    <link name="upper_link">
      <inertial><mass>4.0</mass><inertia><ixx>0.04</ixx><iyy>0.04</iyy><izz>0.05</izz></inertia></inertial>
      <collision name="upper_collision"><pose>0 0 0.10 0 0 0</pose><geometry><box><size>0.26 0.24 0.20</size></box></geometry></collision>
      <visual name="upper_visual"><pose>0 0 0.10 0 0 0</pose><geometry><box><size>0.26 0.24 0.20</size></box></geometry><material><diffuse>0.85 0.60 0.05 1</diffuse></material></visual>
    </link>
    <joint name="fold_joint" type="prismatic">
      <parent>base_link</parent><child>upper_link</child><pose>0 0 0.20 0 0 0</pose>
      <axis><xyz>0 0 1</xyz><limit><lower>-0.16</lower><upper>0.0</upper><effort>200</effort><velocity>0.10</velocity></limit><dynamics><damping>2.0</damping></dynamics></axis>
    </joint>
    <link name="lidar_link">
      <pose relative_to="upper_link">0 0 0.20 0 0 0</pose>
      <visual name="lidar_visual"><geometry><cylinder><radius>0.04</radius><length>0.04</length></cylinder></geometry><material><diffuse>0.05 0.70 0.90 1</diffuse></material></visual>
    </link>
    <joint name="lidar_joint" type="fixed"><parent>upper_link</parent><child>lidar_link</child></joint>
    <link name="imu_link"><pose relative_to="base_link">0 0 0.12 0 0 0</pose></link>
    <joint name="imu_joint" type="fixed"><parent>base_link</parent><child>imu_link</child></joint>
    <plugin filename="ignition-gazebo-joint-position-controller-system" name="ignition::gazebo::systems::JointPositionController">
      <joint_name>fold_joint</joint_name>
      <topic>/model/hnu2027_sentry_proxy/joint/fold_joint/0/cmd_pos</topic>
      <p_gain>30</p_gain><i_gain>0</i_gain><d_gain>2</d_gain>
      <cmd_max>0.1</cmd_max><cmd_min>-0.1</cmd_min>
    </plugin>
  </model>
</sdf>
