<?xml version="1.0"?>
<package format="3">
  <name>hnu_gazebo_adapter</name><version>0.1.0</version>
  <description>Measured-feedback Gazebo adapter for upper-controller coordination.</description>
  <maintainer email="sentry@example.invalid">HNU sentry team</maintainer>
  <license>Proprietary</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>
  <build_depend>ignition-gazebo6</build_depend><build_depend>ignition-plugin1</build_depend>
  <exec_depend>rclpy</exec_depend><exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend><exec_depend>nav_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend><exec_depend>hnu_sentry_interfaces</exec_depend>
  <exec_depend>hnu_tunnel_controller</exec_depend>
  <exec_depend>hnu2027_sentry_bringup</exec_depend>
  <exec_depend>hnu2027_sentry_description</exec_depend>
  <exec_depend>hnu2027_sentry_simulation</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>launch_ros</exec_depend><exec_depend>ament_index_python</exec_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
